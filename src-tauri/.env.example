# Tauri updater signing — set in the release environment (GitHub Actions secrets),
# never commit real values. Generate with:  npx tauri signer generate -w ~/.tauri/ffa-updater.key
# Only TAURI_SIGNING_PRIVATE_KEY needs to be a repo secret. The password may be empty
# (the CI workflow passes an empty string) — only set it if you generated the key WITH one.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
