# Future phases — not needed for the mock-first UI slice
# Neon Postgres (phase 8b) — auto-injected by the Vercel Marketplace Neon integration.
# Locally: `vercel env pull .env.local`. Enables fill history; without it the dashboard
# renders empty and fills are simply not recorded (best-effort).
DATABASE_URL=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
# Free Gemini API key (https://aistudio.google.com) — enables LLM extraction of
# contextual fields. Without it the pipeline still returns regex fields.
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenRouter API key (https://openrouter.ai/keys) — default LLM provider. Free
# models like moonshotai/kimi-k2.6:free work from RU without a VPN.
# Without it the pipeline still returns regex fields (graceful degradation).
OPENROUTER_API_KEY=
# Optional ranking attribution shown on openrouter.ai (safe to leave blank).
OPENROUTER_SITE_URL=
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# Auth.js (phase 8a) — credentials login, JWT sessions
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
# AUTH_USERS: JSON array of allowed users. Hash passwords with:
#   node scripts/hash-password.mjs <password>
# IMPORTANT: escape every "$" in the bcrypt hash as "\$" — Next.js (@next/env)
# runs values through dotenv-expand, which would otherwise eat "$2b"/"$10" as
# variable references and corrupt the hash.
AUTH_USERS=[{"email":"you@example.com","name":"Your Name","hash":"\$2a\$10\$replace_me"}]
